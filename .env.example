# Server
PORT=3000

# Admin dashboard login (HTTP Basic auth). CHANGE THESE.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Consultation fee charged through Razorpay, in rupees
CONSULTATION_FEE_INR=500
CLINIC_NAME=NYL Clinic

# Razorpay keys (Dashboard -> Account & Settings -> API Keys).
# Leave empty to run without payments (submissions are still recorded).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret for POST /api/razorpay/webhook (event: payment.captured / order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Phone verification by SMS OTP before patient names are shown.
# Off by default. Set OTP_ENABLED=true (and an SMS_PROVIDER below) to turn it on.
OTP_ENABLED=false
# SMS_PROVIDER: console (dev: prints the code in the server log) | msg91 | 2factor | twilio
SMS_PROVIDER=console
# MSG91 (https://msg91.com) – OTP template must be DLT-approved
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# 2Factor (https://2factor.in) – template name is optional
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
# Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
