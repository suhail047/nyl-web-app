# Server
PORT=3000

# Admin dashboard login (HTTP Basic auth). CHANGE THESE.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional default consultation fee in rupees, pre-filled on the payment page.
# Leave empty for no default: the patient enters the amount. Can also be set in the admin dashboard → Settings.
CONSULTATION_FEE_INR=
CLINIC_NAME=Suhail's Healing

# UPI QR payments (simplest option, no payment gateway needed).
# UPI ID that receives payments. The payment page shows a UPI QR for it, and staff confirm
# payments on the admin dashboard. Leave the line out to use the built-in default
# (suhailbinalionline-2@oksbi); set it empty (UPI_ID=) to turn UPI off.
UPI_ID=suhailbinalionline-2@oksbi
# Name shown to the patient in their UPI app (defaults to CLINIC_NAME)
UPI_NAME=

# Razorpay keys (only used if UPI_ID is empty) (Dashboard -> Account & Settings -> API Keys).
# Leave empty to run without payments (submissions are still recorded).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret for POST /api/razorpay/webhook (event: payment.captured / order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Phone verification by SMS OTP before patient names are shown.
# Off by default. Set OTP_ENABLED=false
OTP_ENABLED=false
# SMS_PROVIDER: console (dev: prints the code in the server log) | msg91 | 2factor | twilio
SMS_PROVIDER=console
# MSG91 (https://msg91.com) – OTP template must be DLT-approved
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# 2Factor (https://2factor.in) – template name is optional
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE=
# Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
